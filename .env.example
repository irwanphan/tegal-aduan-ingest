# Variabel untuk service n8n di Railway (jangan commit nilai asli)

# --- Meta ---
META_APP_SECRET=          # App Secret dari Meta App (untuk verifikasi X-Hub-Signature-256)
META_VERIFY_TOKEN=        # string acak buatan sendiri, dipakai saat mendaftarkan webhook

# --- Pseudonimisasi (UU PDP) ---
HASH_SALT=                # openssl rand -hex 32
ENCRYPTION_KEY=           # openssl rand -hex 32  (32 byte -> AES-256-GCM, hanya untuk DM/WA)

# --- n8n: wajib agar Code node boleh memakai crypto & membaca env ---
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
WEBHOOK_URL=https://<domain-n8n>.up.railway.app/
N8N_ENCRYPTION_KEY=       # openssl rand -hex 32, simpan baik-baik (mengenkripsi kredensial n8n)
